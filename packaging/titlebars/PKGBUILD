pkgname=omarchy-hyprland-titlebars
pkgver=0.4.0
pkgrel=1.1
pkgdesc='Upstream Omarchy floating titlebars built for the Kasm compositor ABI'
arch=('x86_64')
url='https://github.com/omacom/omarchy-hyprland-titlebars'
license=('BSD-3-Clause' 'MIT')
depends=('glibc' 'libgcc' 'libstdc++' 'hyprlang' 'hyprutils' 'hyprland=0.57.2')
makedepends=('git' 'cmake' 'ninja')
options=('!debug')
source=('git+https://github.com/omacom/omarchy-hyprland-titlebars.git#commit=929ed753a667dd7d13688e0c8b2d5c930f1babda')
sha256sums=('SKIP')

build() {
  cmake -S "$srcdir/omarchy-hyprland-titlebars" -B "$srcdir/build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/build" --parallel 2
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"
  install -Dm644 "$srcdir/omarchy-hyprland-titlebars/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/omarchy-hyprland-titlebars/LICENSE.MIT" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.MIT"
}
